# Copy to .env and adjust. Every value below is optional; defaults run fully offline.

# PostgreSQL + pgvector (docker compose service "db", published on 127.0.0.1:5433).
# "appalti" is a default for local development only: set your own password for anything else.
# docker compose reads POSTGRES_PASSWORD when it first creates the database volume, and builds
# the app's DATABASE_URL from it; keep the password below in sync (URL-encoded).
POSTGRES_PASSWORD=appalti
DATABASE_URL=postgresql://appalti:appalti@localhost:5433/appalti
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# Corpus
RAW_DIR=data/raw/akn

# Embeddings (local, CPU). Upgrade option: BAAI/bge-m3 with EMBEDDING_DIM=1024 (re-run init + embed)
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIM=768
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# LLM: fake | anthropic | groq. "fake" needs no key and is deterministic.
LLM_PROVIDER=fake
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_S=60
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# LLM judge used by the evaluation (fake | anthropic | groq)
JUDGE_PROVIDER=fake
JUDGE_MODEL=claude-opus-5-5

# Retrieval
DEFAULT_TOP_K=8
RETRIEVAL_MODE=hybrid
RRF_K=60
MIN_RELEVANCE_SCORE=0.0

# Public demo limits
MAX_QUESTION_CHARS=500
RATE_LIMIT_PER_IP_PER_HOUR=20
RATE_LIMIT_GLOBAL_PER_DAY=500
# GET /api/v1/search (no answer generation, but the query is embedded on CPU); 0 disables
RATE_LIMIT_SEARCH_PER_IP_PER_HOUR=120
# Salt for hashing client IPs in qa_log (random per process when empty)
CLIENT_HASH_SALT=

# Web
# Trusted reverse proxies (comma-separated IPs/CIDRs); empty = ignore X-Forwarded-For.
# The client is the rightmost X-Forwarded-For hop that is not a listed proxy. "*" trusts any
# peer and then uses only the rightmost hop (the one added by the proxy in front of the app):
# prefer listing the proxies. IPv6 clients are rate limited per /64 network.
FORWARDED_ALLOW_IPS=
LOG_LEVEL=INFO
